{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "P=python3; \"$P\" -c '' 2>/dev/null || P=python; \"$P\" \"${CLAUDE_PLUGIN_ROOT}/hooks/bouncer.py\"",
            "timeout": 35
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "P=python3; \"$P\" -c '' 2>/dev/null || P=python; \"$P\" \"${CLAUDE_PLUGIN_ROOT}/hooks/bouncer.py\""
          }
        ]
      }
    ]
  }
}
